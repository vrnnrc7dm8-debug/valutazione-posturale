# Solo backend. Non usare prefissi VITE_ per queste variabili.
CLINICAL_VOLUME=/Volumes/Lexar
CLINICAL_DB_PATH='/Volumes/Lexar/app valutazione posturale/database/valutazione_posturale.db'
CLINICAL_FILES_ROOT='/Volumes/Lexar/app valutazione posturale/pazienti'
# Opzionale: hash scrypt password locale. Vedere backend/README.md.
# CLINICAL_PASSWORD_HASH=

# SynthPose sperimentale: solo backend; download esplicito, mai all'avvio.
SYNTHPOSE_MODEL_DIR=/Volumes/Lexar/valutazione-posturale/models/synthpose-vitpose-base-hf
SYNTHPOSE_MIN_CONFIDENCE=0.50
SYNTHPOSE_HIGH_CONFIDENCE=0.75
# 0 = intera immagine; eventuale inset centrato fra 0 e 0.2.
SYNTHPOSE_BBOX_INSET=0
# Revisione utilizzata soltanto dallo script di download (preferire un commit SHA).
# SYNTHPOSE_REVISION=main
